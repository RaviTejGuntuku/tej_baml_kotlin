{% if let Some(docstring) = docstring -%}
{{ crate::utils::prefix_lines(docstring, "/// ") }}
{%- endif %}
sealed class {{ name }} {
    {% for variant in variants -%}
    data class {{ variant.name }}(val value: {{ variant.type_.serialize_type(pkg) }}) : {{ name }}()
    {% endfor %}

    companion object : BamlDeserializable<{{ name }}> {
        override fun decode(fields: Map<String, Any?>, typeMap: BamlTypeMap): {{ name }} {
            val variantName = Serde.coerceString(Serde.requireField(fields, "variant_name"))
            val value = Serde.requireField(fields, "value")
            return when (variantName) {
                {% for variant in variants -%}
                "{{ variant.cffi_name }}" -> {{ variant.name }}({{ variant.type_.decode_expr("value", pkg) }})
                {% endfor -%}
                else -> throw IllegalArgumentException("Unknown variant '$variantName' for union {{ name }}")
            }
        }
    }
}
